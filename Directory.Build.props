<Project>

  <!-- Settings shared by every project in the repository. A project overrides by setting the same
       property in its own file. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NuGet metadata for the packable libraries. Both packages version in lockstep. Knope writes the
       version when it prepares a release; add a change file in .changeset instead of editing it. -->
  <PropertyGroup>
    <Version>0.0.0</Version>
    <Authors>Leo Conforti</Authors>
    <Copyright>Copyright (c) 2026 Leo Conforti</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/leonitousconforti/fsharp-astro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/leonitousconforti/fsharp-astro</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Source Link and symbols, so a consumer can step into the published code. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The F# SDK adds an implicit FSharp.Core reference at this version. Pinned so the type provider
       loads in editors whose language server bundles this FSharp.Core, and so consumers of the
       libraries get the lowest workable floor. -->
  <PropertyGroup>
    <FSharpCoreImplicitPackageVersion>10.0.100</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

</Project>
